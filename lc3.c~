#include <stdio.h>
#include <stdint.h>
#include <signal.h>

#include <stdlib.h>
#include <unistd.h> /*PSOIX api*/
#include <fcntl.h>
#include <sys/time.h>
#include <sys/types.h>
#include <sys/termios.h>
#include <sys/mman.h>

enum
  {
    R0 = 0,
    R1,
    R2,
    R3,
    R4,
    R5,
    R6,
    R7,
    PC,
    COND,
    COUNT
  };
enum
  {
    POS = 1 << 0,
    ZERO = 1 << 1,
    NEG = 1 << 2,
  };
enum
  {
    BR = 0, /*branch*/
    ADD,
    LD,
    ST,
    JSR, /*jump(register)*/
    AND,
    LDR, /*load(register)*/
    STR, /*store(register)*/
    RTI, /*DON'T USE*/
    NOT,
    LDI, /*load(indirect)*/
    STI, /*store(indirect)*/
    JMP,
    RES, /*reserved in LC-3*/
    LEA, /*load(effective)*/
    TRAP
  };
enum
  {
    GETC = 0X20,/*getchar no terminal echo*/
    OUT = 0x21, /*output char*/
    PUTS = 0x22, /*output word string*/
    IN = 0x23, /*getchar with terminal echo*/
    PUTSP = 0x24, /*output byte string*/
    HALT = 0x25 
  };

enum
  {
    KBSR = 0xFE00, /*keyboard status register*/
    KBDR = 0xFE02   /*keyboard data register*/
  };

#define MEMORY (1 << 16)
uint16_t memory[MEMORY];
uint16_t reg[COUNT];  
  
struct termios original_tio; /*control input processing modes*/

void disable_input_buffering()
{
    tcgetattr(STDIN_FILENO, &original_tio);/*get current terminal atributes for stdin(STDIN_FILENO is a file descriptor)*/
    struct termios new_tio = original_tio;
    new_tio.c_lflag &= ~ICANON & ~ECHO;/*disable cannonical and echo modes*/
    tcsetattr(STDIN_FILENO, TCSANOW, &new_tio);
}

void restore_input_buffering()
{
    tcsetattr(STDIN_FILENO, TCSANOW, &original_tio);
}

uint16_t check_key()
{
    fd_set readfds; /*file descriptor*/
    FD_ZERO(&readfds); /*clear*/
    FD_SET(STDIN_FILENO, &readfds); /*add file descriptor for standard input to readfds set*/

    struct timeval timeout;
    timeout.tv_sec = 0;
    timeout.tv_usec = 0;
    return select(1, &readfds, NULL, NULL, &timeout) != 0;
}

void handle_interrupt(int signal)
{
    restore_input_buffering();
    printf("\n");
    exit(-2);
}

uint16_t signextend(uint16_t x,int bitcount)
{
  if ((x >> (bitcount - 1)) & 1)
    {
      x |= (0xFFFF << bitcount);
    }
  return x;
}

uint16_t swap16(uint16_t x)
{
  return (x << 8) | (x >> 8);
}

void updateflags(uint16_t r)
{
  if (reg[r] == 0)
    {
      reg[COND] = ZERO;
    }
  else if (reg[r] >> 15)
    {
      reg[COND] = NEG;
    }
  else
    {
      reg[COND] = POS;
    }
}

void readimagefile(FILE* file)
{
  uint16_t origin; /*starting address where image will be placed in memory*/
  fread(&origin, sizeof(origin), 1, file); 
  origin = swap16(origin);

  uint16_t maxread = MEMORY - origin; /*max elements readable*/
  uint16_t* p = memory + origin; /* place image after origin*/
  size_t read = fread(p, sizeof(uint16_t), maxread, file); /*store elements starting at address p, store number of elements actually read*/

  while(read-- > 0)
    {
      *p = swap16(*p); /*convert endianness on each element read*/
      ++p;
    }
}

int readimage(const char* imagepath)
{
  FILE* file = fopen(imagepath, "rb");
  if (!file)
    {
      return 0;
    }
  readimagefile(file);
  fclose(file);
  return 1;
}

void mem_write(uint16_t address, uint16_t val)
{
    memory[address] = val;
}

uint16_t mem_read(uint16_t address)
{
    if (address == KBSR)
    {
        if (check_key())
        {
            memory[KBSR] = (1 << 15);
            memory[KBDR] = getchar();
        }
        else
        {
            memory[KBSR] = 0;
        }
    }
    return memory[address];
}

int main(int argc, const char* argv[])
{
  /*handle arguments*/
  if (argc < 2)
    {
      printf("Please type lc3 [image_filename1] [image_filename2] ...\n");
      exit(2);
    }

  for (int img = 1; img < argc; ++img)
    {
      if (!readimage(argv[img]))
	{
	  printf("Couldn't read image file %s.\n",argv[img]);
	  exit(1);
	}
    }
  /*setup*/
  signal(SIGINT, handle_interrupt);/*when user C-c, exit*/
  disable_input_buffering(); /*disable cannonical and echo mode*/

  reg[COND] = ZERO;

  /*set PC to 0x3000(default starting position for LC-3)*/
  enum {PCSTART = 0X3000};
  reg[PC] = PCSTART;

  int running = 1;
  while (running)
    {
      /*FETCH*/
      uint16_t instr = mem_read(reg[PC]++);
      uint16_t op = instr >> 12;

      switch (op)
	{
	case ADD:
	  {
	    uint16_t r0 = (instr >> 9) & 0x7;/*get destination register*/
	    uint16_t r1 = (instr >> 6) & 0x7; /*firstoperand(SR1)*/
	    uint16_t immediate = (instr >> 5) & 0x1;

	    if (immediate)
	      {
		uint16_t imm5 = signextend(instr & 0x1F, 5);
		reg[r0] = reg[r1] + imm5;
	      }
	    else
	      {
		uint16_t r2 = instr & 0x7;
		reg[r0] = reg[r1] + reg[r2];
	      }
	    updateflags(r0);
	  }
	  break;
	case AND:
		{
                    uint16_t r0 = (instr >> 9) & 0x7;
                    uint16_t r1 = (instr >> 6) & 0x7;
                    uint16_t immediate = (instr >> 5) & 0x1;
                
                    if (immediate)
                    {
                        uint16_t imm5 = signextend(instr & 0x1F, 5);
                        reg[r0] = reg[r1] & imm5;
                    }
                    else
                    {
                        uint16_t r2 = instr & 0x7;
                        reg[r0] = reg[r1] & reg[r2];
                    }
                    updateflags(r0);
                }
                break;
	case NOT:
		{
                    uint16_t r0 = (instr >> 9) & 0x7;
                    uint16_t r1 = (instr >> 6) & 0x7;
                
                    reg[r0] = ~reg[r1];
                    updateflags(r0);
                }
                break;
	case BR:
		{
                    uint16_t pc_offset = signextend(instr & 0x1FF, 9);
                    uint16_t cond_flag = (instr >> 9) & 0x7;
                    if (cond_flag & reg[COND])
                    {
                        reg[PC] += pc_offset;
                    }
                }
                break;
	case JMP:
		{
                    /* Also handles RET */
                    uint16_t r1 = (instr >> 6) & 0x7;
                    reg[PC] = reg[r1];
                }
                break;
	case JSR:
		{
                    uint16_t long_flag = (instr >> 11) & 1;
                    reg[R7] = reg[PC];
                    if (long_flag)
                    {
                        uint16_t long_pc_offset = signextend(instr & 0x7FF, 11);
                        reg[PC] += long_pc_offset;  /* JSR */
                    }
                    else
                    {
                        uint16_t r1 = (instr >> 6) & 0x7;
                        reg[PC] = reg[r1]; /* JSRR */
                    }
                }
                break;
	case LD:
		 {
                    uint16_t r0 = (instr >> 9) & 0x7;
                    uint16_t pc_offset = signextend(instr & 0x1FF, 9);
                    reg[r0] = mem_read(reg[PC] + pc_offset);
                    updateflags(r0);
                }
                break;
	case LDI:
		{
                    uint16_t r0 = (instr >> 9) & 0x7; /*DR*/
                    uint16_t pc_offset = signextend(instr & 0x1FF, 9); /* PCoffset 9*/
                    reg[r0] = mem_read(mem_read(reg[PC] + pc_offset)); /* add pc offset to current PC,location contains final address*/
                    updateflags(r0);
                }
	case LDR:
		{
                    uint16_t r0 = (instr >> 9) & 0x7;
                    uint16_t r1 = (instr >> 6) & 0x7;
                    uint16_t offset = signextend(instr & 0x3F, 6);
                    reg[r0] = mem_read(reg[r1] + offset);
                    updateflags(r0);
                }
                break;		
	case LEA:
		{
                    uint16_t r0 = (instr >> 9) & 0x7;
                    uint16_t pc_offset = signextend(instr & 0x1FF, 9);
                    reg[r0] = reg[PC] + pc_offset;
                    updateflags(r0);
                }
                break;
	case ST:
		{
                    uint16_t r0 = (instr >> 9) & 0x7;
                    uint16_t pc_offset = signextend(instr & 0x1FF, 9);
                    mem_write(reg[PC] + pc_offset, reg[r0]);
                }
                break;
	case STI:
		{
                    uint16_t r0 = (instr >> 9) & 0x7;
                    uint16_t pc_offset = signextend(instr & 0x1FF, 9);
                    mem_write(mem_read(reg[PC] + pc_offset), reg[r0]);
                }
                break;
	case STR:
		{
                    uint16_t r0 = (instr >> 9) & 0x7;
                    uint16_t r1 = (instr >> 6) & 0x7;
                    uint16_t offset = signextend(instr & 0x3F, 6);
                    mem_write(reg[r1] + offset, reg[r0]);
                }
                break;
	case TRAP:
	  {
	    reg[R7] = reg[PC];

	    switch (instr & 0XFF)
	      {
	      case GETC: /*readsinglechar*/
		{
		  reg[R0] = (uint16_t)getchar();
		  updateflags(R0);
		}
		break;
	      case OUT:
		{
		  putc((char)reg[R0], stdout);
		  fflush(stdout);
		}
		break;
	      case PUTS:
		{
		  uint16_t* c = memory + reg[R0];
		  while (*c)
		    {
		      putc((char)*c, stdout);
		      ++c;
		    }
		  fflush(stdout);
		}
		break;
	      case IN:
		{
		  printf("Enter a character: ");
		  char c = getchar();
		  putc(c, stdout);
		  fflush(stdout);
		  reg[R0] = (uint16_t)c;
		  updateflags(R0);
		}
		break;
	      case PUTSP:
		{
		  uint16_t* c = memory + reg[R0];
		  while (*c)
		    {
		      char char1 = (*c) & 0xFF;
		      putc(char1, stdout);
		      char char2 = (*c) >> 8;
		      if (char2) putc(char2, stdout);
		      ++c;
		    }
		  fflush(stdout);
		}
		break;
	      case HALT:
		  puts("HALT");
		  fflush(stdout);
		  running = 0;
	      	  break;
	  }
	case RES:
	case RTI:
	default:
		
			abort();
			break;
		
		
	}
    }
  restore_input_buffering();
  /*return terminal attributes*/
}
}

